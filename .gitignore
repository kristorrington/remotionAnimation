node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
# EXCEPTION: out/shorts/*.mp4 are committed — the GitHub Actions cloud
# dispatcher (social-dispatch.yml) posts them from the runner.
out/*
!out/shorts/
out/shorts/*
!out/shorts/*.mp4

# Local Claude settings (machine-specific)
.claude/settings.local.json

# Source footage & proxies — large / personal, keep local (see AGENTS.md §8)
/_talking-head-4k.mp4
/public/talking-head*.mp4
/_footage-backup/

# Tutorial / demo composite footage — large, keep local (see AGENTS.md §13)
/claude-code-tutorial*.mp4
/public/claude-code-tutorial*.mp4

# Local whisper.cpp tool clone (large, machine-specific)
/whisper.cpp/

# Social queue is COMMITTED (no secrets — captions/times/statuses) so the
# GitHub Actions cloud dispatcher shares state with this machine.

# Raw b-roll captures (moved out of public/ so renders don't copy them)
/_broll-raw/
