# Social publishing secrets. Copy to .env (gitignored) and fill in.
# NOTHING here is ever committed. Leave a platform's vars blank to skip it.

# --- YouTube (native scheduling) ---
# Google Cloud project -> enable "YouTube Data API v3" -> OAuth client (Desktop app).
# Then run: node scripts/social/auth-youtube.mjs  (prints YT_REFRESH_TOKEN)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- TikTok (upload to drafts/inbox) ---
# TikTok for Developers app -> Content Posting API -> OAuth -> access token.
# (Access tokens expire ~24h; re-auth or add a refresh step when needed.)
TIKTOK_ACCESS_TOKEN=

# --- Instagram Reels (publish when due) ---
# IG Business/Creator account linked to a Facebook Page + a Meta app with
# instagram_content_publish. Long-lived token + the IG user id.
IG_USER_ID=
IG_ACCESS_TOKEN=

# Instagram fetches the video from a PUBLIC URL. This command must upload $FILE
# and print the public URL on stdout ($BASENAME is the file name).
# Example (S3):  aws s3 cp "$FILE" s3://BUCKET/social/ --acl public-read >/dev/null && echo "https://BUCKET.s3.amazonaws.com/social/$BASENAME"
SOCIAL_UPLOAD_CMD=
# Optional cleanup after IG confirms the post ($URL is what SOCIAL_UPLOAD_CMD printed):
SOCIAL_UNHOST_CMD=
